      replacement_content: "import { motion } from \'motion/react\';\n\nexport function Hero() {\n  return (\n    <section id=\"home\" className=\"relative min-h-screen bg-brand-black text-white flex items-center pt-20 pb-16 md:py-0 overflow-hidden\">\n      <div className=\"w-full max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-2 gap-12 items-center\">\n        \n        {/* Text Content */}\n        <motion.div \n          initial={{ opacity: 0, y: 30 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 0.8, ease: \"easeOut\" }}\n          className=\"order-2 md:order-1 flex flex-col items-start\"\n        >\n          <h1 className=\"text-5xl md:text-7xl lg:text-8xl font-serif tracking-tight mb-6 leading-[1.1]\">\n            Dr. Lee <br className=\"hidden md:block\" /> Warren\n          </h1>\n          <p className=\"text-lg md:text-xl text-gray-300 font-sans font-light max-w-md mb-10 leading-relaxed\">\n            Neurocirujano, autor de best-sellers y presentador de podcast dise\303\261ado para ayudarte a transformar tu mente y cambiar tu vida.\n          </p>\n          <a flex=\"true\" href=\"#book\" className=\"inline-block px-8 py-4 border border-white text-white font-sans tracking-widest uppercase text-sm hover:bg-white hover:text-black transition-colors duration-300\">\n            Descubre mi libro\n          </a>\n        </motion.div>\n\n        {/* High Contrast Image */}\n        <motion.div \n          initial={{ opacity: 0, scale: 0.95 }}\n          animate={{ opacity: 1, scale: 1 }}\n          transition={{ duration: 1, delay: 0.2, ease: \"easeOut\" }}\n          className=\"order-1 md:order-2 relative w-full h-[50vh] md:h-[80vh] flex justify-center md:justify-end\"\n        >\n          {/* Subtle gradient overlay to merge image with black background if needed */}\n          <div className=\"absolute inset-0 bg-gradient-to-t from-brand-black via-transparent to-transparent z-10 md:bg-gradient-to-l\" />\n          <img \n            src=\"https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=1000&q=80\" \n            alt=\"Dr. Lee Warren\" \n            className=\"w-full h-full object-cover object-top filter grayscale contrast-125\"\n            draggable=\"false\"\n          />\n        </motion.div>\n      </div>\n    </section>\n  );\n}\n"
    }
    diff {
      unified_diff {
        lines {
          text: "import { motion } from \'motion/react\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
