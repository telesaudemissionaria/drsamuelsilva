    replacement_chunks {
      replacement_content: "import { motion } from \'motion/react\';\n\nexport function About() {\n  return (\n    <section id=\"about\" className=\"bg-brand-cream text-black py-24 md:py-32 overflow-hidden\">\n      <div className=\"w-full max-w-7xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-2 gap-16 md:gap-24 items-start\">\n        \n        {/* Title */}\n        <motion.div \n          initial={{ opacity: 0, x: -40 }}\n          whileInView={{ opacity: 1, x: 0 }}\n          viewport={{ once: true, margin: \"-100px\" }}\n          transition={{ duration: 0.8, ease: \"easeOut\" }}\n        >\n          <span className=\"text-sm uppercase tracking-widest font-semibold mb-3 block\">Qui\303\251n soy</span>\n          <h2 className=\"text-4xl md:text-5xl font-serif tracking-tight leading-tight\">\n            M\303\251dico que lleva la medicina donde el sistema no llega\n          </h2>\n        </motion.div>\n\n        {/* Text Content */}\n        <motion.div \n          initial={{ opacity: 0, y: 30 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true, margin: \"-100px\" }}\n          transition={{ duration: 0.8, delay: 0.2, ease: \"easeOut\" }}\n          className=\"flex flex-col gap-8 font-sans font-light text-lg text-gray-800 leading-relaxed\"\n        >\n          <p>\n            Soy m\303\251dico general con m\303\241s de 13 a\303\261os de pr\303\241ctica en comunidades rurales de Bolivia \342\200\224 desde el altiplano andino hasta el Amazonas boliviano. Con la convicci\303\263n que me llev\303\263 al campo: que la calidad de tu salud no deber\303\255a depender de d\303\263nde naciste.\n          </p>\n          \n          <div>\n            <h3 className=\"text-sm uppercase tracking-widest font-semibold mb-2 text-black\">Qu\303\251 Hago</h3>\n            <p>\n              Mi pr\303\241ctica integra medicina cl\303\255nica, salud comunitaria, telemedicina en baja conectividad y \303\251tica m\303\251dica frente a la inteligencia artificial. La fe no es un a\303\261adido \342\200\224 es el fundamento que define c\303\263mo entiendo al paciente: como persona que lleva la imagen de Dios.\n            </p>\n          </div>\n\n          <div>\n            <h3 className=\"text-sm uppercase tracking-widest font-semibold mb-2 text-black\">Mi Formaci\303\263n</h3>\n            <p>\n              M\303\251dico por la Universidad De Aquino Bolivia (UDABOL). Certificado en ACLS, Salud Digital y Vertex AI (Google).\n            </p>\n          </div>\n        </motion.div>\n\n      </div>\n    </section>\n  );\n}"
    }
