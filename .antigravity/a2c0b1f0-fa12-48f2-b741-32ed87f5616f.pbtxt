    replacement_chunks {
      replacement_content: "import { motion } from \'motion/react\';\n\nexport function Areas() {\n  const areas = [\n    {\n      id: \"01\",\n      title: \"Medicina humanizada\",\n      desc: \"El paciente no es un conjunto de s\303\255ntomas. Es una persona con historia, dignidad y un Creador. La medicina que no ve eso no cura \342\200\224 solo trata.\"\n    },\n    {\n      id: \"02\",\n      title: \"Fe y ciencia\",\n      desc: \"La fe cristiana intelectual no teme la ciencia \342\200\224 la entiende mejor. Hablo desde la intersecci\303\263n de John Lennox, Timothy Keller y 13 a\303\261os de campo real.\"\n    },\n    {\n      id: \"03\",\n      title: \"IA m\303\251dica y \303\251tica\",\n      desc: \"Los algoritmos no tienen coraz\303\263n. El m\303\251dico s\303\255. La IA en salud necesita supervisi\303\263n humana y una ancla moral \342\200\224 no neutralidad.\"\n    }\n  ];\n\n  return (\n    <section id=\"areas\" className=\"bg-white text-black py-24 md:py-32\">\n      <div className=\"w-full max-w-7xl mx-auto px-6 md:px-12\">\n        \n        {/* Header */}\n        <motion.div \n          initial={{ opacity: 0, y: 30 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true, margin: \"-100px\" }}\n          transition={{ duration: 0.8, ease: \"easeOut\" }}\n          className=\"mb-16 md:mb-24 md:flex md:justify-between md:items-end gap-12\"\n        >\n          <div className=\"max-w-2xl\">\n            <span className=\"text-sm uppercase tracking-widest font-semibold mb-3 block\">\303\201reas de enfoque</span>\n            <h2 className=\"text-4xl md:text-5xl lg:text-6xl font-serif tracking-tight mb-6 mt-4\">\n              Tres conversaciones que la medicina necesita tener\n            </h2>\n          </div>\n          <p className=\"text-lg text-gray-600 font-sans font-light max-w-md md:pb-2\">\n            El m\303\251dico del siglo XXI no puede ignorar la fe, la tecnolog\303\255a ni el territorio. Aqu\303\255 hablo de los tres.\n          </p>\n        </motion.div>\n\n        {/* Grid */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8\">\n          {areas.map((area, index) => (\n             <motion.div \n              key={area.id}\n              initial={{ opacity: 0, y: 30 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true, margin: \"-100px\" }}\n              transition={{ duration: 0.8, delay: index * 0.2, ease: \"easeOut\" }}\n              className=\"border-t border-gray-200 pt-8\"\n            >\n              <span className=\"text-gray-400 font-serif text-3xl block mb-4\">{area.id}</span>\n              <h3 className=\"text-xl font-sans font-semibold mb-4\">{area.title}</h3>\n              <p className=\"text-gray-600 font-sans font-light leading-relaxed\">\n                {area.desc}\n              </p>\n            </motion.div>\n          ))}\n        </div>\n\n      </div>\n    </section>\n  );\n}"
    }
